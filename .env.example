# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only: Next.js never
# sends them to the browser. Variables WITH NEXT_PUBLIC_ are visible to
# anyone who opens the site, so never put a secret in one.

# Google Places API (New): server-only key, used by our Route Handlers.
# Restrict it in Google Cloud to "Places API (New)" only.
GOOGLE_MAPS_API_KEY=your-google-places-server-key

# Google Maps JavaScript API: a SEPARATE browser key for the map. It's public
# by design (NEXT_PUBLIC_), so restrict it in Google Cloud to your websites
# (http://localhost:3000/* and your deployed domain) and to "Maps JavaScript API" only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# OpenAI: server-only key from a dedicated project with a monthly budget.
OPENAI_API_KEY=your-openai-api-key
# Optional: which model builds itineraries (defaults to gpt-6.1-terra).
OPENAI_MODEL=gpt-6.1-terra

# Supabase (saved trips). Server-only: the SECRET key bypasses Row Level
# Security. URL format: https://<project-ref>.supabase.co (not the dashboard URL).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Random secret used to sign generated plans so only real ones can be saved.
# Generate with: openssl rand -hex 32
TRIP_SIGNING_SECRET=your-random-64-character-hex-string
