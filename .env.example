# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only: Next.js never
# sends them to the browser. Variables WITH NEXT_PUBLIC_ are visible to
# anyone who opens the site, so never put a secret in one.

# Google Places API (New): server-only key, used by our Route Handlers.
# Restrict it in Google Cloud to "Places API (New)" only.
GOOGLE_MAPS_API_KEY=your-google-places-server-key
